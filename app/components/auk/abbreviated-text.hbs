{{#if this.textTooLong}}
  <div class="auk-o-flex">
    {{#if (has-block)}}
      {{yield this.abbreviatedText}}
    {{else}}
      {{this.abbreviatedText}}
    {{/if}}
    <AuTooltip @placement="bottom" as |tooltip|>
      <AuLink
        {{tooltip.target}}
        @skin="secondary"
        @icon="circle-three-dots"
        @hideText={{true}}
        class="au-u-margin-left-tiny"
      >
        {{t "show-full-text"}}
      </AuLink>
      <tooltip.Content>
        {{@text}}
      </tooltip.Content>
    </AuTooltip>
  </div>
{{else}}
  {{#if (has-block)}}
    {{yield @text}}
  {{else}}
    {{@text}}
  {{/if}}
{{/if}}