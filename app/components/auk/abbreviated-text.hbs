{{#if this.textTooLong}}
  <div class="auk-o-flex">
    {{#if (has-block)}}
      {{yield this.abbreviatedText}}
    {{else}}
      {{this.abbreviatedText}}
    {{/if}}
    <AuTooltip @placement="bottom" as |tooltip|>
      <Auk::ButtonLink
        {{tooltip.target}}
        @icon="circle-three-dots"
        @skin="muted"
        @layout="icon-only"
        class="auk-o-flex--vertical-center"
      ></Auk::ButtonLink>
      <tooltip.Content>
        {{@text}}
      </tooltip.Content>
    </AuTooltip>
  </div>
{{else}}
  {{#if (has-block)}}
    {{yield @text}}
  {{else}}
    {{@text}}
  {{/if}}
{{/if}}