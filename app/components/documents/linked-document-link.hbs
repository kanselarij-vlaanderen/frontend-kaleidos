<div class="vlc-document-card" data-test-linked-document-link-card ...attributes>
  <div class="vlc-document-card__summary">
    <div class="vlc-document-card__content">
      <Auk::Toolbar @auto={{true}} @responsive={{true}} as |Toolbar|>
        <Toolbar.Group @position="left" @responsive={{true}} as |Group|>
          <Group.Item>
            <AuBadge
              @icon="document"
              @skin="gray"
              class="au-c-badge--medium"
            />
          </Group.Item>
          <Group.Item class="auk-u-maximize-width">
            <div class="auk-o-flex auk-o-flex--vertical-center auk-o-flex--spaced">
              <span class="auk-overline">
                {{@documentContainer.type.altLabel}}
              </span>
            </div>
            <LinkTo
              data-test-linked-document-link-name
              @route="document"
              @model={{this.lastPiece.id}}
              class="auk-h4"
            >
              {{#let
                (or
                  this.lastPiece.file.derived.extension this.lastPiece.file.extension
                )
                as |extension|
              }}
                {{this.lastPiece.name}}{{#if extension}}.{{extension}}{{/if}}
              {{/let}}
            </LinkTo>
            <div class="vlc-document-card-content__meta">
              {{#if (not this.loadData.isRunning)}}
                <p>
                  {{#if (or this.lastPiece.created this.lastPiece.file.created)}}
                    {{t "uploaded-at"}}
                    {{datetime-at (or this.lastPiece.file.created this.lastPiece.created)}}
                  {{/if}}
                  {{#if
                    (and
                      this.lastPiece.file.derived
                      (await (this.canViewConfidentialPiece))
                    )
                  }}
                    {{t "as"}}
                    <AuLinkExternal
                      href={{await this.lastPiece.namedDownloadLinkPromise}}
                      download
                    >
                      {{t "source-file-lowercase"}}
                    </AuLinkExternal>
                  {{/if}}
                </p>
              {{/if}}
              {{#if
                (await (this.canViewConfidentialPiece))
              }}
                {{#if this.lastPiece.signedPieceCopy.file}}
                  <p>
                    <AuLinkExternal
                      href={{await
                        this.lastPiece.signedPieceCopy.namedDownloadLinkPromise
                      }}
                      download
                    >
                      {{t "signed-document"}}
                    </AuLinkExternal>
                    {{t "on"}}
                    {{datetime-at (or this.lastPiece.signedPieceCopy.file.created this.lastPiece.signedPieceCopy.created)}}
                  </p>
                {{/if}}
              {{/if}}
            </div>
          </Group.Item>
        </Toolbar.Group>
        <Toolbar.Group @position="right" as |Group|>
          <Group.Item
            class="auk-o-flex auk-o-flex--vertical-center"
          >
            {{#if this.lastPiece}}
              <AccessLevelPill
                @accessLevel={{this.accessLevel}}
              />
            {{/if}}
          </Group.Item>
          <Group.Item
            class="auk-o-flex auk-o-flex--vertical-center"
          >
            {{#if (user-may "manage-documents")}}
              <AuButton
                @skin="naked"
                @alert={{true}}
                @icon="link-broken"
                @hideText={{true}}
                {{on "click" this.deletePieceLink}}
              >
                {{t "delete"}}
              </AuButton>
            {{/if}}
          </Group.Item>
        </Toolbar.Group>
      </Auk::Toolbar>
    </div>
  </div>
  {{#if (user-may "view-document-version-info")}}
    {{#if this.reverseSortedPieceHistory.length}}
      <div class="vlc-document-card-versions">
        <Auk::Accordion>
          <Auk::Accordion::Item @title={{t "previous-versions"}}>
            {{#each this.reverseSortedPieceHistory as |piece|}}
              <div
                class="vlc-document-holder"
                {{did-update (perform this.loadData) piece}}
              >
                <div class="vlc-document-card-item" data-test-vl-document-piece>
                  <div class="vlc-document-card-item__title">
                    {{#if piece.file}}
                    {{! explicit await, we don't want to load this data until it is needed}}
                      {{#let (await piece.file.derived) as |derivedFile|}}
                        {{#let
                          (or
                            derivedFile.extension piece.file.extension
                          )
                          as |extension|
                        }}
                          <LinkTo
                            data-test-vl-document-name
                            class="auk-h4 auk-u-m-0 auk-u-mr-4 vlc-document-card-item__title-link"
                            @route="document"
                            @model={{piece.id}}
                          >
                            {{piece.name}}{{#if extension}}.{{extension}}{{/if}}
                          </LinkTo>
                        {{/let}}
                      {{/let}}
                    {{else}}
                      <h6
                        class="auk-h4 auk-u-m-0 auk-u-mr-4 vlc-document-card-item__title-link"
                        data-test-vl-document-name
                      >
                        <EmberTooltip @side="bottom" @tooltipClass="auk-tooltip">
                          {{t "document-not-consultable"}}
                        </EmberTooltip>
                        {{piece.name}}
                      </h6>
                    {{/if}}
                    <div class="auk-o-flex auk-o-flex--spaced auk-o-flex--vertical-center"></div>
                  </div>
                  <div class="vlc-document-card-item__meta au-u-muted">
                    {{#if piece.created}}
                      {{t "uploaded-at"}}
                      {{datetime-at (or piece.file.created piece.created)}}
                    {{/if}}
                  </div>
                  <div class="vlc-document-card-item__icon">
                    <AuIcon @icon="clock-rewind" />
                  </div>
                </div>
              </div>
            {{/each}}
          </Auk::Accordion::Item>
        </Auk::Accordion>
      </div>
    {{/if}}
  {{/if}}
</div>

<ConfirmationModal
  @modalOpen={{this.isOpenVerifyDeleteModal}}
  @title={{t "document-unlink"}}
  @message={{t "unlink-document-message"}}
  @onConfirm={{this.verifyDeletePieceLink}}
  @onCancel={{this.cancelDeletePieceLink}}
  @confirmMessage={{t "unlink"}}
  @confirmIcon="trash"
  @alert={{true}}
/>