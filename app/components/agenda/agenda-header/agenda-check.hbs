{{!
  @argument {object} meeting
  @argument {object} model
  @argument {string} saveLabel
  @argument {task} onCancel
  @argument {task} onSave
}}
<div class="au-c-panel-sidebar">
  <Auk::Panel class="auk-panel--editing">
    <Auk::Panel::Header @size="auto" class="au-u-background-gray-100">
      <Auk::Toolbar @auto={{true}} as |Toolbar|>
        <Toolbar.Group @position="left">
          <h4 class="auk-toolbar__title">
            {{t "check-agenda"}}
          </h4>
        </Toolbar.Group>
      </Auk::Toolbar>
    </Auk::Panel::Header>
    <Auk::Panel::Body>
      {{#if (or this.fileNameMappings.isRunning this.agendaitems.isRunning)}}
        <Auk::Loader />
      {{else}}
        <div class="auk-u-mx-2">
          <Utils::LogoHeader />
          <h2
            class="auk-h2 auk-u-text-family-serif auk-u-text-align--center auk-u-mt-5 auk-u-mb-10"
          >
            {{t "agenda-of"}}
            {{#if @meeting.isPreKaleidos}}
              {{date @meeting.plannedStart}}
            {{else}}
              {{datetime-at @meeting.plannedStart}}
            {{/if}}
            -
            {{kind-print-label @meeting.kind}}
          </h2>
          {{#if (not @canBeApproved)}}
            <AuAlert
              @skin="error"
              @icon="circle-x"
              @size="small"
              class="auk-u-mb-2"
            >
              <p>{{t "check-agenda-not-ok-message" }}</p>
            </AuAlert>
          {{/if}}
          <div class="auk-content">
            {{#if this.agendaitems.value.notaGroups}}
              <div>
                <div
                  class="auk-o-flex auk-u-mb-4 l-printable-agenda__section-header"
                >
                  <div class="l-printable-agenda__header-prefix">A.</div>
                  <h3
                    class="auk-u-text-uppercase auk-u-m-0 auk-u-text-decoration-underline"
                  >{{t "agendaitems"}}</h3>
                </div>
                <div class="l-printable-agenda__section-content">
                  {{#each this.agendaitems.value.notaGroups as |notaGroup|}}
                    <Agenda::PrintableAgenda::ListSection::ItemGroup
                      @items={{notaGroup}}
                      @fileNameMappings={{this.fileNameMap}}
                      @hideNotFormallyOk={{true}}
                    />
                  {{/each}}


                  {{!-- Mock agenda item --}}

                  <div id="mock-agenda__item--view" class="l-printable-agenda__item-group">
                    <div class="l-printable-agenda__faux-item">
                      <div class="auk-u-non-breakable-group@print">
                      </div>
                      <h3 class="auk-u-mb-3 auk-u-text-uppercase l-printable-agenda__item-group-header">
                        Vlaams minister van [...]
                      </h3>
                    </div>

                    <div>
                      <div class="l-printable-agenda__item">
                        <div>
                          <div class="auk-o-flex auk-u-mb au-u-flex--vertical-center l-printable-agenda__item-header">
                            <div class="l-printable-agenda__header-prefix">
                              6.
                            </div>
                            <h4 class="auk-u-m-0 auk-u-text-pre-line">Title of the item</h4>
                            <button {{on "click" this.toggleEditing}} class="l-printable-agenda__item-header__edit">
                              <AuIcon
                                @icon="pencil"
                              />
                            </button>
                          </div>
                          <div class="auk-u-mb-4 l-printable-agenda__item-indented">
                              <p>Description of the item</p>
                          </div>
                        </div>
                        <ul class="l-printable-agenda__document-list l-printable-agenda__item-indented">
                          <li>
                            <span class="auk-o-flex--inline auk-o-flex--vertical-center au-u-flex--between document-content">
                              <div class="auk-u-ml-2 au-u-flex au-u-flex--spaced-tiny au-u-flex--vertical-center">
                                Document name #1
                              </div>
                              <span class="au-c-pill-container">
                                <span class="au-c-pill au-c-pill--warning">
                                  Intern Regering
                                </span>
                              </span>
                            </span>
                          </li>
                          <li>
                            <span class="auk-o-flex--inline auk-o-flex--vertical-center au-u-flex--between document-content">
                              <div class="auk-u-ml-2 au-u-flex au-u-flex--spaced-tiny au-u-flex--vertical-center">
                                Document name #2
                              </div>
                              <span class="au-c-pill-container">
                                <span class="au-c-pill au-c-pill--warning">
                                  Intern Regering
                                </span>
                              </span>
                            </span>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>

                  <div id="mock-agenda__item--editing" class="l-printable-agenda__item-group hidden">
                    <div class="l-printable-agenda__faux-item">
                      <div class="auk-u-non-breakable-group@print">
                      </div>
                      <h3 class="auk-u-mb-3 auk-u-text-uppercase l-printable-agenda__item-group-header">
                        Vlaams minister van [...]
                      </h3>
                    </div>

                    <div>
                      <div class="l-printable-agenda__item">
                        <div>
                          <div class="auk-o-flex auk-u-mb au-u-flex--vertical-center l-printable-agenda__item-header">
                            <div class="l-printable-agenda__header-prefix">
                              6.
                            </div>
                            <AuInput
                              value={{"Title of the item"}}
                              id="input"
                            />
                          </div>
                          <div class="auk-u-mb-4 l-printable-agenda__item-indented">
                              <AuTextarea
                                id="textaerea"
                              />
                              <div class="auk-u-mt-2 au-u-flex au-u-flex--spaced-tiny au-u-flex--vertical-center">
                                  <AuToggleSwitch>Beperkte toegang</AuToggleSwitch>
                              </div>
                          </div>
                        </div>
                        <ul class="l-printable-agenda__document-list l-printable-agenda__item-indented">
                          <li>
                            <span class="auk-o-flex--inline auk-o-flex--vertical-center au-u-flex--between document-content">
                              <div class="auk-u-ml-2 au-u-flex au-u-flex--spaced-tiny au-u-flex--vertical-center">
                                Document name #1
                                <AuIcon
                                  @icon="pencil"
                                />
                              </div>
                              <span class="au-c-pill-container">
                                <span class="au-c-pill au-c-pill--warning" data-test-access-level-pill="">
                                  Intern Regering
                                </span>
                                <button class="au-c-pill-action au-c-pill--warning" type="button">
                                  <AuIcon
                                    @icon="pencil"
                                  />
                                  <span class="au-u-hidden-visually"></span>
                                </button>
                              </span>
                            </span>
                          </li>
                          <li>
                            <span class="auk-o-flex--inline auk-o-flex--vertical-center au-u-flex--between document-content">
                              <div class="auk-u-ml-2 au-u-flex au-u-flex--spaced-tiny au-u-flex--vertical-center">
                                Document name #2
                                <AuIcon
                                  @icon="pencil"
                                />
                              </div>
                              <span class="au-c-pill-container">
                                <span class="au-c-pill au-c-pill--warning" data-test-access-level-pill="">
                                  Intern Regering
                                </span>
                                <button class="au-c-pill-action au-c-pill--warning" type="button">
                                  <AuIcon
                                    @icon="pencil"
                                  />
                                  <span class="au-u-hidden-visually"></span>
                                </button>
                              </span>
                            </span>
                          </li>
                        </ul>
                        <div class="auk-o-flex auk-u-mt-2 au-u-flex--spaced-tiny au-u-flex--between l-printable-agenda__item-indented">
                          <div class="auk-o-flex au-u-flex--spaced-tiny">
                            <AuButton
                              @skin="primary"
                              {{on "click" this.toggleEditing}}
                            >
                              Save
                            </AuButton>
                            <AuButton
                              @skin="secondary"
                              {{on "click" this.toggleEditing}}
                            >
                              Cancel
                            </AuButton>
                          </div>
                          <AuButton @skin="naked">
                            Go to edit page
                          </AuButton>
                        </div>
                      </div>
                    </div>
                  </div>

                  {{!-- End mock agenda item --}}

                </div>
              </div>
            {{/if}}

            {{#if this.agendaitems.value.announcements}}
              <div class="auk-u-on-fresh-page@print">
                <div
                  class="auk-o-flex auk-u-mb-4 l-printable-agenda__section-header"
                >
                  <div class="l-printable-agenda__header-prefix">B.</div>
                  <h3
                    class="auk-u-text-uppercase auk-u-m-0 auk-u-text-decoration-underline"
                  >{{t "announcements-subtitle"}}</h3>
                </div>
                <div class="l-printable-agenda__section-content">
                  {{#each (filter-by "isFormallyOk" this.agendaitems.value.announcements) as |announcement|}}
                    <div class="l-printable-agenda__item">
                      <div class="auk-u-non-breakable-group@print">
                        <Agenda::PrintableAgenda::ListSection::ItemGroup::Item::Content
                          @item={{announcement}}
                        />
                      </div>
                      {{#let (await announcement.pieces) as |pieces|}}
                        {{#if pieces}}
                          <Agenda::PrintableAgenda::ListSection::ItemGroup::Item::DocumentList
                            @pieces={{pieces}}
                            @fileNameMappings={{this.fileNameMap}}
                          />
                        {{/if}}
                      {{/let}}
                    </div>
                  {{/each}}
                </div>
              </div>
            {{/if}}
          </div>
        </div>
      {{/if}}
    </Auk::Panel::Body>
    <Auk::Panel::Footer>
      <Auk::Toolbar>
        <Auk::Toolbar::Group @position="left">
          <Auk::Toolbar::Item>
            <AuButton data-test-agenda-check-cancel @skin="naked" {{on "click" @onCancel}}>
              {{t "cancel"}}
            </AuButton>
          </Auk::Toolbar::Item>
        </Auk::Toolbar::Group>
        <Auk::Toolbar::Group @position="right">
          <Auk::Toolbar::Item>
            <AuButton
              data-test-agenda-check-confirm
              @skin="primary"
              @loading={{this.fileNameMappings.isRunning}}
              @disabled={{not this.fileNameMap}}
              {{on "click" this.onSave}}>
              {{@saveLabel}}
            </AuButton>
          </Auk::Toolbar::Item>
        </Auk::Toolbar::Group>
      </Auk::Toolbar>
    </Auk::Panel::Footer>
  </Auk::Panel>
</div>
