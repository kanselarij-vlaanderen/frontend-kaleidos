<Auk::Modal @size="medium">
  <Auk::Modal::Header
    @title={{or @title (t "publish-publication-modal-title")}}
    @onClose={{@onCancel}}
    @closeDisabled={{this.confirmPublish.isRunning}}
  />
  <Auk::Modal::Body>
    {{#if @warningMessage}}
      <AuAlert
        @title={{t "warning-title"}}
        @skin="warning"
        @icon="alert-triangle"
        @size="small"
      >
        <p>{{@warningMessage}}</p>
      </AuAlert>
    {{/if}}
    <p>{{this.confirmationMessage}}</p>
  </Auk::Modal::Body>
  <Auk::Modal::Footer
    @onCancel={{@onCancel}}
    @cancelDisabled={{this.confirmPublish.isRunning}}
  >
    <AuButton
      @skin="primary"
      @alert={{@warningMessage}}
      @loading={{this.confirmPublish.isRunning}}
      @loadingMessage={{t "loading"}}
      {{on "click" (perform this.confirmPublish)}}
    >
      {{t (if @warningMessage "publish-anyway" "publish-to-public")}}
    </AuButton>
  </Auk::Modal::Footer>
</Auk::Modal>