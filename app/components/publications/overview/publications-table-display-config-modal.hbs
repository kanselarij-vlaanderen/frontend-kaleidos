<AuCheckboxGroup
  @selected={{this.selectedOptions}}
  @onChange={{this.onChangeOptions}}
  as |Group|
>
  {{#each this.options as |option|}}
    <Group.Checkbox
      data-test-overview-table-display-config-option-checkbox={{option.keyName}}
      @value={{option}}
    >
      <span>
        {{t option.translationKey}}
        {{#if
          (not-eq
            (t option.translationKey) (t option.translationKeySmall)
          )
        }}
          <span class="auk-u-text-size--small auk-u-text-muted">
            ({{t option.translationKeySmall}})
          </span>
        {{/if}}
      </span>
    </Group.Checkbox>
  {{/each}}
</AuCheckboxGroup>
<AuButton
  class="auk-u-mt-2"
  @skin="link-secondary"
  {{on "click" this.reset}}
>
  {{t "reset-display"}}
</AuButton>