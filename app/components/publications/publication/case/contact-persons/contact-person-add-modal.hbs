<Auk::Modal
  @size="medium">
  <Auk::Modal::Header
    @title={{t "add-contact"}}
    @onClose={{@onCancel}}
    @closeDisabled={{this.save.isRunning}}/>
  <Auk::Modal::Body>
    <Utils::LoadableContent @isLoading={{this.save.isRunning}} @reserveSpace={{true}}>
      <div class="au-c-form">
        <AuFormRow>
          <AuLabel for="organizationInput">
            {{t "organization"}}
          </AuLabel>
          <div data-test-contact-person-select-organization class="auk-o-flex">
            <PowerSelect
              @options={{this.organizations}}
              @selected={{this.selectedOrganization}}
              @searchEnabled={{true}}
              @search={{this.searchOrganizations.perform}}
              @noMatchesMessage={{t "organizations-empty-result"}}
              @placeholder={{t "search-organization"}}
              @onChange={{this.selectOrganization}}
              @allowClear={{false}}
              @triggerId="organizationInput"
              as |organization|>
              {{#if organization.isNoOrganization}}
                {{t "no-organization-select-option"}}
              {{else}}
                {{organization.name}}
              {{/if}}
            </PowerSelect>
            <AuButton
              data-test-contact-person-add-organization
              @skin="primary"
              @icon="plus"
              @hideText={{true}}
              class="auk-o-flex__item--fix auk-u-ml-2"
              {{on "click" this.openOrganizationAddModal}}
            >
              {{t "add-organization"}}
            </AuButton>
          </div>
        </AuFormRow>
        {{#if this.isCreatingNewPerson}}
          <div class="auk-o-grid">
            <div class="auk-o-grid-col-6">
              <AuFormRow>
                <AuLabel
                  for="firstNameInput"
                  @required={{true}}
                  @error={{this.validators.person.showError}}
                >
                  {{t "first-name"}}
                </AuLabel>
                <AuInput
                  data-test-contact-person-add-first-name
                  id="firstNameInput"
                  value={{this.firstName}}
                  @width="block"
                  @error={{this.validators.person.showError}}
                  {{on "input" this.onInputFirstName}}
                  />
              </AuFormRow>
            </div>
            <div class="auk-o-grid-col-6">
              <AuFormRow>
                <AuLabel
                  for="lastNameInput"
                  @required={{true}}
                  @error={{this.validators.person.showError}}
                >
                  {{t "last-name"}}
                </AuLabel>
                <AuInput
                  data-test-contact-person-add-last-name
                  id="lastNameInput"
                  value={{this.lastName}}
                  @width="block"
                  @error={{this.validators.person.showError}}
                  {{on "input" this.onInputLastName}}
                  />
              </AuFormRow>
            </div>
          </div>
          <AuFormRow>
            <AuLabel for="emailInput">
              {{t "email"}}
            </AuLabel>
            <AuInput
              data-test-contact-person-add-email
              id="emailInput"
              value={{this.email}}
              @width="block"
              {{on "input" (pick "target.value" (set this "email"))}}
              />
          </AuFormRow>
          <AuButton
            @skin="link"
            @icon="chevron-left"
            {{on "click" this.cancelCreatingNewPerson}}
          >
            {{t "select-existing-contact-person"}}
          </AuButton>
        {{else}}
          <AuFormRow>
            <AuLabel
              for="contactPersonInput"
              @required={{true}}
              @error={{this.validators.person.showError}}
            >
              {{t "contact-person"}}
            </AuLabel>
            <div data-test-contact-person-select-person class="auk-o-flex">
              <PowerSelect
                @options={{this.persons}}
                @selected={{this.selectedPerson}}
                @searchEnabled={{true}}
                @search={{perform this.searchPersons}}
                @noMatchesMessage={{t "contact-persons-empty-result"}}
                @placeholder={{t "search-contact-person"}}
                @onChange={{this.selectPerson}}
                @allowClear={{true}}
                @triggerId="contactPersonInput"
                as |person|>
                {{person.fullName}}
                {{#if person.contactPerson.email}}
                  <span class="auk-u-text-muted auk-u-text-size--small auk-u-ml-1">
                    {{person.contactPerson.email}}
                  </span>
                {{/if}}
              </PowerSelect>
              <AuButton
                data-test-contact-person-add-new-person
                @skin="primary"
                @icon="plus"
                @hideText={{true}}
                class="auk-o-flex__item--fix auk-u-ml-2"
                {{on "click" this.startCreatingNewPerson}}
              >
                {{t "create-new-contact-person"}}
              </AuButton>
            </div>
          </AuFormRow>
        {{/if}}
      </div>
    </Utils::LoadableContent>
  </Auk::Modal::Body>
  <Auk::Modal::Footer @onCancel={{@onCancel}} @cancelDisabled={{this.save.isRunning}}>
    <AuButton
      data-test-contact-person-add-submit
      @skin="primary"
      @icon="plus"
      @disabled={{not this.validators.areValid}}
      @loading={{this.save.isRunning}}
      @loadingMessage={{t "loading"}}
      {{on "click" this.save.perform}}
    >
      {{t "add"}}
    </AuButton>
  </Auk::Modal::Footer>
</Auk::Modal>

{{#if this.isOpenOrganizationAddModal}}
  <Publications::Publication::Case::ContactPersons::OrganizationAddModal
    @onCancel={{this.closeOrganizationAddModal}}
    @onSave={{this.addOrganization}} />
{{/if}}