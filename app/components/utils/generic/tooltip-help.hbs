<AuTooltip @placement="{{this.position}}" as |tooltip|>
  <Auk::ButtonLink
    {{tooltip.target}}
    @layout="icon-only"
    @icon="circle-info"
    @skin="muted"
    class="auk-u-inline auk-m-l"
    ...attributes
  ></Auk::ButtonLink>
  <tooltip.Content>
    {{yield}}
  </tooltip.Content>
</AuTooltip>