{{!-- template-lint-disable  --}}
<ComponentPageIntro @title="Key/value" />

<StyleguideSample
        @title="Key value"
        @snippet="key-value.hbs"
>
  {{!-- BEGIN-SNIPPET key-value --}}
  <dl class="auk-key-values-list">
    {{#each (array 1 2 3) as |item|}}
      <div class="auk-key-value-item">
        <dt class="auk-key-value-item__label">Label</dt>
        <dd class="auk-key-value-item__value">Data</dd>
      </div>
    {{/each}}
  </dl>
  {{!-- END-SNIPPET --}}

</StyleguideSample>

<StyleguideSample
        @title="Key value (horizontal)"
        @snippet="key-value-horizontal.hbs"
>
  {{!-- BEGIN-SNIPPET key-value-horizontal --}}
  <dl class="auk-key-values-list">
    {{#each (array 1 2 3) as |item|}}
      <div class="auk-key-value-item auk-key-value-item--horizontal">
        <dt class="auk-key-value-item__label">Label</dt>
        <dd class="auk-key-value-item__value">Data</dd>
      </div>
    {{/each}}
  </dl>
  {{!-- END-SNIPPET --}}
</StyleguideSample>
