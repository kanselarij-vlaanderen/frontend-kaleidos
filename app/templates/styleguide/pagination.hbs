{{!-- template-lint-disable  --}}
<ComponentPageIntro @title="Pagination" />

<StyleguideSample
        @title="Pagination"
        @snippet="pagination.hbs"
>
  {{!-- BEGIN-SNIPPET pagination --}}
  <div class="auk-pagination">
    <ul class="auk-pagination__list">
      <li class="auk-pagination__element">
        <p><strong>1-10</strong> van 142</p>
      </li>
      <li class="auk-pagination__element">
        <AuButton @skin="link" @icon="chevron-left" @disabled={{true}} class="auk-u-text-vertical-align--middle">Vorige</AuButton>
      </li>
      <li class="auk-pagination__element">
        <AuButton @skin="link" @icon="chevron-right" @iconAlignment="right" class="auk-u-text-vertical-align--middle">Volgende</AuButton>
      </li>
    </ul>
  </div>
  {{!-- END-SNIPPET --}}
</StyleguideSample>
