{{page-title (t "new-submission")}}
<div class="prevent-unload-wrapper" {{prevent-unload}}></div>
<Cases::NewSubmission
  @decisionmakingFlow={{@model.decisionmakingFlow}}
  @latestSubcase={{@model.latestSubcase}}
  @disableEdit={{true}}
  @submitter={{this.submitter}}
  @mandatees={{this.mandatees}}
  @onCancel={{this.onCancelSubmission}}
  @onCreateSubmission={{this.onCreateSubmission}}
/>
